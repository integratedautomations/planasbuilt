# Copy to .env. For the production compose stack the first three are required.

# Random 32+ char secret: openssl rand -hex 32  (server refuses to start in production without it)
JWT_SECRET=
# Password for the bundled postgres container: openssl rand -hex 24
POSTGRES_PASSWORD=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=
# Starts the cloudflared service. Remove this line for local testing without a tunnel (see docker-compose.local.yml)
COMPOSE_PROFILES=tunnel

# Public https address of the site, exactly as people type it (no trailing path). Invite and reset links are built from
# it and cross-origin API access is limited to it. Set this! If empty, links fall back to the request's Host header.
PUBLIC_URL=
# First-run setup code (needed once, to create the first admin). Leave empty to have the app generate one and print it in
# the app log (docker compose logs app | grep 'First-run setup code'). Ignored once any user exists.
SETUP_TOKEN=

# Backups (compose `backup` service): hour of day (container time, UTC) and days to keep
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# ---- Local dev only (ignored by compose; leave DATABASE_URL empty for embedded PGlite in ./data/pglite)
DATABASE_URL=
DATA_DIR=./data
PORT=3001
DEV_ADMIN_EMAIL=admin@planmark.test
DEV_ADMIN_PASSWORD=devpass123
