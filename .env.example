# Copy to .env. For the production compose stack the first three are required.

# Random 32+ char secret: openssl rand -hex 32  (server refuses to start in production without it)
JWT_SECRET=
# Password for the bundled postgres container: openssl rand -hex 24
POSTGRES_PASSWORD=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=

# Backups (compose `backup` service): hour of day (container time, UTC) and days to keep
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# ---- Local dev only (ignored by compose; leave DATABASE_URL empty for embedded PGlite in ./data/pglite)
DATABASE_URL=
DATA_DIR=./data
PORT=3001
DEV_ADMIN_EMAIL=admin@planmark.test
DEV_ADMIN_PASSWORD=devpass123
